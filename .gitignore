# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
*.swp

# Virtual environment
.venv/
.venv-release/

# Windows release build output
.release-build/

# Git worktrees
.worktrees/

# Raw photos (too large for git)
*.CR2

# Generated caches
Prisma/data/thumbnails/

# System backups (safety snapshots, too large for git)
Prisma/data/_backup_*/

# Scratch / tmp output from one-off runs
tmp_boundary_previews/
tmp_orientation_checks/
Prisma/generator/.tmp/

# Local Codex/dev-server run artifacts
.codex-work/**/*.log
.codex-work/**/*.pid
.codex-work/tmp_*/
.codex-work/verify_*/
.codex-work/generator-wave-fixtures/
.codex-work/generator-wave-captures/

# Git worktree scaffolding (isolated working copies)
.claude/worktrees/
Prisma/generator/.claude/

# Claude auto-memory (persistent local state, not repo content)
.claude/projects/

# Task tracking (generated dashboard)
.status/dashboard.html

# Reference codebase (not version-tracked)

# Sandbox web app data (isolated copies, not canonical)
unified_calibration/sandbox/thumbnails/
unified_calibration/sandbox/images/
unified_calibration/sandbox/blanks/
unified_generator/sandbox/
unified_generator/output/
spectral_calibration/

# Root-level scratch images
/de_debug.png
/palette_suggest*.png
/Screenshot*.png
screenshots/

# User data (not version-tracked)
/Calibration/
/Generator/
Prisma/inbox/
Prisma/photos/
Prisma/output/
Prisma/generator/app/modules.local.json
Prisma/generator/app/printers.local.json
Prisma/generator/.data-root
Prisma/calibration/.data-root
Prisma/calibration/.backend
Prisma/calibration/.sqlite-path
Prisma/calibration/.asset-root

# System-managed data (not version-tracked except pinned generator presets)
Prisma/data/calibration_revised_backend.sqlite
Prisma/data/*.sqlite
Prisma/data/*.sqlite-*
Prisma/data/*.json
Prisma/data/_system/
Prisma/data/extraction_results/
Prisma/data/filaments/
Prisma/data/samples/
Prisma/data/strips/
Prisma/data/images/
Prisma/data/segmentation/
Prisma/data/step/
Prisma/data/previews/
Prisma/data/blanks/
Prisma/data/generator/

# Evidence-backed refinement profiles are shipped with the product.
# Re-include only that directory after the blanket generator-data exclusion.
!Prisma/data/generator/
!Prisma/data/generator/settings_profiles/
Prisma/data/generator/settings_profiles/*
!Prisma/data/generator/settings_profiles/refinement/
!Prisma/data/generator/settings_profiles/refinement/**

# Stage 9a: generated/clearable generator data — never tracked (regenerated on
# demand). These sit under the re-included Prisma/data/generator/ above, so they
# need explicit re-ignoring after the negation.
Prisma/data/generator/cache/
Prisma/data/generator/logs/
Prisma/data/generator/saved_runs/

# Managed STEP artifact cache — regenerated from _system/steps_registry.json
# on demand; do not track. (The registry itself IS tracked.)
Prisma/data/_system/step_artifacts/
Prisma/data/_system/image_metadata.json

# Camera Transform artifact — system-managed build output (CURRENT pointer +
# gen-* dirs) published by the calibration build job; provisioned into
# worktrees via a directory junction. Never version-controlled.
Prisma/data/camera_transform/
